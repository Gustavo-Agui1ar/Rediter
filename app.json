{
  "expo": {
    "name": "Rediter",
    "slug": "Rediter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/black_r.png",
    "scheme": "rediter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Rediter.ios",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.Rediter.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/black_r.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/black_r.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/logo/black_r.png",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/logo/black_r.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "minSdkVersion": 24,
            "buildToolsVersion": "34.0.0",
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "O aplicativo precisa de permissão para acessar suas fotos.",
          "savePhotosPermission": "O aplicativo precisa de permissão para salvar fotos na galeria."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a8f3594-cb7a-4e8a-b1bc-24e5bcab3606"
      }
    }
  }
}
