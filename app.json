{
  "expo": {
    "name": "Rediter",
    "slug": "Rediter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/black_r.png",
    "scheme": "rediter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Rediter.ios"
    },
    "android": {
      "package": "com.Rediter.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/black_r.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo/black_r.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/logo/white_r.png",
          "dark": {
            "image": "./assets/logo/white_r.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 300
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a8f3594-cb7a-4e8a-b1bc-24e5bcab3606"
      }
    }
  }
}
